# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Número de WhatsApp del negocio (con código de país, sin +)
# Ejemplo: 5491123456789
WHATSAPP_NUMBER=

# --- Notificaciones por Email ---
# Email del negocio (desde donde se envían los correos)
# Usa Gmail con una 'Contraseña de aplicación'
SMTP_EMAIL=tuemail@gmail.com
SMTP_PASSWORD=tu_contraseña_de_aplicacion
# Email del administrador (donde recibirás las notificaciones de reservas)
ADMIN_EMAIL=tuemail@gmail.com

# Integración con Supabase para la base de datos
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
